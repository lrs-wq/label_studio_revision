[Unit]
Description=Label Studio YOLO Pose Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/label_studio/yolo_pose_ls_backend
Environment=MODEL_PATH=/data/label_studio/models/cat_pose_trainmap_noaug_300e_best.pt
Environment=MODEL_VERSION=cat_pose_trainmap_noaug_300e_best
Environment=LABEL_STUDIO_DATA_DIR=/root/label_studio/label_studio_data
Environment=LOCAL_FILES_DOCUMENT_ROOT=/data/label_studio/local_files
Environment=CONFIDENCE_THRESHOLD=0.20
Environment=KPT_CONFIDENCE_THRESHOLD=0.20
ExecStart=/root/label_studio/.venv-yolo/bin/gunicorn --bind 127.0.0.1:9091 --workers 1 --threads 2 --timeout 240 app:app
Restart=always
RestartSec=5
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
